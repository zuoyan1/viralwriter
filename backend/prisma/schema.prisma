generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String   // 密码字段，加密存储
  createdAt DateTime @default(now())

  evaluations EvaluationHistory[]
  polishes    PolishHistory[]

  @@map("user")
}

model EvaluationHistory {
  id          String   @id @default(cuid())
  content     String
  platform    String
  category    String
  overallScore    Float
  result      String   // Store JSON as string
  createdAt   DateTime @default(now())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])

  @@map("evaluation_history")
}

model PolishHistory {
  id           String   @id @default(cuid())
  original     String
  polished     String
  style        String
  platform     String
  category     String
  changes      String   // Store JSON as string
  createdAt    DateTime @default(now())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@map("polish_history")
}
